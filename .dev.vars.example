# Copy this file to .dev.vars for local Pages Functions development.
# Do not commit .dev.vars or production secrets.
DRIVE_PORTAL_ACCESS_MODE=public
GOOGLE_DRIVE_FOLDER_ID=replace-with-your-google-drive-folder-id
GOOGLE_DRIVE_API_KEY=replace-with-a-restricted-google-drive-api-key
DRIVE_STATUS_ACCESS_TOKEN=replace-with-a-long-random-operator-token

# For private folder access, set DRIVE_PORTAL_ACCESS_MODE=private and provide:
# GOOGLE_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"..."}
